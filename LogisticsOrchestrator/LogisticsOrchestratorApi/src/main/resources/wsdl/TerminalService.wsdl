<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://warehouse.com/logistics/terminal"
    targetNamespace="http://warehouse.com/logistics/terminal"
    name="TerminalService">

    <wsdl:types>
        <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
                   targetNamespace="http://warehouse.com/logistics/terminal"
                   xmlns="http://warehouse.com/logistics/terminal"
                   elementFormDefault="qualified"
                   attributeFormDefault="unqualified">

            <xs:element name="TerminalRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ProcessType" type="ProcessTypeEnum"/>
                        <xs:element name="Device" type="DeviceType" minOccurs="0"/>
                        <xs:element name="DeliveryRejectRequest" type="DeliveryRejectRequestType" minOccurs="0"/>
                        <xs:element name="DeliveryReturnRequest" type="DeliveryReturnRequestType" minOccurs="0"/>
                        <xs:element name="DeliveryMissedRequest" type="DeliveryMissedRequestType" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="TerminalResponse" type="TerminalResponseType"/>

            <xs:element name="CollectRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="DeviceInformation" type="DeviceType"/>
                        <xs:element name="CollectDetails" type="CollectDetailsType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="CollectResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ProcessId" type="xs:string"/>
                        <xs:element name="Success" type="xs:boolean"/>
                        <xs:element name="CollectResponseDetails" type="CollectResponseDetailsType" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:complexType name="CollectDetailsType">
                <xs:sequence>
                    <xs:element name="CollectDetail" type="CollectDetailType" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="CollectDetailType">
                <xs:sequence>
                    <xs:element name="TrackingNumber" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="CollectResponseDetailsType">
                <xs:sequence>
                    <xs:element name="CollectResponseDetail" type="CollectResponseDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="CollectResponseDetailType">
                <xs:sequence>
                    <xs:element name="TrackingNumber" type="xs:string"/>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="Success" type="xs:boolean"/>
                    <xs:element name="ErrorMessage" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:element name="PalletScanRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="DeviceInformation" type="DeviceType"/>
                        <xs:element name="PalletTrackingNumber" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="PalletScanResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ProcessId" type="xs:string"/>
                        <xs:element name="Success" type="xs:boolean"/>
                        <xs:element name="PalletTrackingNumber" type="xs:string"/>
                        <xs:element name="PalletID" type="xs:string" minOccurs="0"/>
                        <xs:element name="PalletStatus" type="xs:string" minOccurs="0"/>
                        <xs:element name="AlreadyLoaded" type="xs:boolean"/>
                        <xs:element name="ErrorCode" type="xs:string" minOccurs="0"/>
                        <xs:element name="ErrorMessage" type="xs:string" minOccurs="0"/>
                        <xs:element name="PalletScanResponseDetails" type="PalletScanResponseDetailsType" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:complexType name="PalletScanResponseDetailsType">
                <xs:sequence>
                    <xs:element name="PalletScanResponseDetail" type="PalletScanResponseDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="PalletScanResponseDetailType">
                <xs:sequence>
                    <xs:element name="ShipmentID" type="xs:long"/>
                    <xs:element name="Success" type="xs:boolean"/>
                    <xs:element name="ShipmentStatus" type="xs:string" minOccurs="0"/>
                    <xs:element name="ErrorMessage" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="TerminalResponseType">
                <xs:sequence>
                    <xs:element name="Device" type="DeviceType" minOccurs="0"/>
                    <xs:element name="DeliveryRejectResponse" type="DeliveryRejectResponseType" minOccurs="0"/>
                    <xs:element name="DeliveryReturnResponse" type="DeliveryReturnResponseType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeviceType">
                <xs:sequence>
                    <xs:element name="Version" type="xs:string" minOccurs="0"/>
                    <xs:element name="DeviceID" type="xs:string" minOccurs="0"/>
                    <xs:element name="ResponsibleUser" type="xs:string" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="PairKey" type="xs:string" minOccurs="0"/>
                    <xs:element name="DeviceUserType" type="DeviceUserTypeEnum" minOccurs="0"/>
                    <xs:element name="DeviceType" type="xs:string" minOccurs="0"/>
                    <xs:element name="DeviceUpToDate" type="DeviceUpToDateEnum" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectRequestType">
                <xs:sequence>
                    <xs:element name="DeliveryRejectDetails" type="DeliveryRejectDetailsType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectDetailsType">
                <xs:sequence>
                    <xs:element name="DeliveryRejectDetail" type="DeliveryRejectDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectDetailType">
                <xs:sequence>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="SupplierCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="DeliveryStatus" type="DeliveryStatusEnum" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="RejectReason" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnRequestType">
                <xs:sequence>
                    <xs:element name="DeliveryReturnDetails" type="DeliveryReturnDetailsType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnDetailsType">
                <xs:sequence>
                    <xs:element name="DeliveryReturnDetail" type="DeliveryReturnDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnDetailType">
                <xs:sequence>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="DeliveryStatus" type="DeliveryStatusEnum" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="SupplierCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="ReturnToken" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryMissedRequestType">
                <xs:sequence>
                    <xs:element name="DeliveryMissedDetails" type="DeliveryMissedDetailsType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryMissedDetailsType">
                <xs:sequence>
                    <xs:element name="DeliveryMissedDetail" type="DeliveryMissedDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryMissedDetailType">
                <xs:sequence>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="DeliveryStatus" type="DeliveryStatusEnum" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="SupplierCode" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectResponseType">
                <xs:sequence>
                    <xs:element name="DeliveryRejectResponseDetails" type="DeliveryRejectResponseDetailsType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectResponseDetailsType">
                <xs:sequence>
                    <xs:element name="DeliveryRejectResponseDetail" type="DeliveryRejectResponseDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryRejectResponseDetailType">
                <xs:sequence>
                    <xs:element name="SupplierCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="NewShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="DeliveryStatus" type="DeliveryStatusEnum" minOccurs="0"/>
                    <xs:element name="RejectReason" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnResponseType">
                <xs:sequence>
                    <xs:element name="DeliveryReturnResponseDetails" type="DeliveryReturnResponseDetailsType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnResponseDetailsType">
                <xs:sequence>
                    <xs:element name="DeliveryReturnResponseDetail" type="DeliveryReturnResponseDetailType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="DeliveryReturnResponseDetailType">
                <xs:sequence>
                    <xs:element name="SupplierCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
                    <xs:element name="ShipmentID" type="xs:long" minOccurs="0"/>
                    <xs:element name="ReturnToken" type="xs:string" minOccurs="0"/>
                    <xs:element name="UpdateStatus" type="xs:string" minOccurs="0"/>
                    <xs:element name="DeliveryStatus" type="DeliveryStatusEnum" minOccurs="0"/>
                    <xs:element name="DeliveryID" type="xs:string" minOccurs="0"/>
                    <xs:element name="ErrorMessage" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:simpleType name="ProcessTypeEnum">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="CREATED"/>
                    <xs:enumeration value="RETURN"/>
                    <xs:enumeration value="ROUTE"/>
                    <xs:enumeration value="REJECT"/>
                    <xs:enumeration value="REROUTE"/>
                    <xs:enumeration value="REDIRECT"/>
                    <xs:enumeration value="MISS"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="DeliveryStatusEnum">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="DEPOT"/>
                    <xs:enumeration value="CLIENT"/>
                    <xs:enumeration value="DELIVERY"/>
                    <xs:enumeration value="SENDER"/>
                    <xs:enumeration value="LOST"/>
                    <xs:enumeration value="UNKNOWN"/>
                    <xs:enumeration value="DELIVERED"/>
                    <xs:enumeration value="REJECTED"/>
                    <xs:enumeration value="RETURN"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="DeviceUserTypeEnum">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="MANAGER"/>
                    <xs:enumeration value="SUPPLIER"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="DeviceUpToDateEnum">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="YES"/>
                    <xs:enumeration value="NO"/>
                </xs:restriction>
            </xs:simpleType>

        </xs:schema>
    </wsdl:types>

    <wsdl:message name="TerminalRequestMessage">
        <wsdl:part name="parameters" element="tns:TerminalRequest"/>
    </wsdl:message>

    <wsdl:message name="TerminalResponseMessage">
        <wsdl:part name="parameters" element="tns:TerminalResponse"/>
    </wsdl:message>

    <wsdl:message name="CollectRequestMessage">
        <wsdl:part name="parameters" element="tns:CollectRequest"/>
    </wsdl:message>

    <wsdl:message name="CollectResponseMessage">
        <wsdl:part name="parameters" element="tns:CollectResponse"/>
    </wsdl:message>

    <wsdl:message name="PalletScanRequestMessage">
        <wsdl:part name="parameters" element="tns:PalletScanRequest"/>
    </wsdl:message>

    <wsdl:message name="PalletScanResponseMessage">
        <wsdl:part name="parameters" element="tns:PalletScanResponse"/>
    </wsdl:message>

    <wsdl:portType name="TerminalPortType">
        <wsdl:operation name="processTerminal">
            <wsdl:input message="tns:TerminalRequestMessage"/>
            <wsdl:output message="tns:TerminalResponseMessage"/>
        </wsdl:operation>

        <wsdl:operation name="processCollect">
            <wsdl:input message="tns:CollectRequestMessage"/>
            <wsdl:output message="tns:CollectResponseMessage"/>
        </wsdl:operation>

        <wsdl:operation name="processPalletScan">
            <wsdl:input message="tns:PalletScanRequestMessage"/>
            <wsdl:output message="tns:PalletScanResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="TerminalSoapBinding" type="tns:TerminalPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="processTerminal">
            <soap:operation soapAction="http://warehouse.com/logistics/terminal/processTerminal"/>

            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>

            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>

        <wsdl:operation name="processCollect">
            <soap:operation soapAction="http://warehouse.com/logistics/terminal/processCollect"/>

            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>

            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>

        <wsdl:operation name="processPalletScan">
            <soap:operation soapAction="http://warehouse.com/logistics/terminal/processPalletScan"/>

            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>

            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="TerminalService">
        <wsdl:port name="TerminalSoapPort" binding="tns:TerminalSoapBinding">
            <soap:address location="http://warehouse.com/logistics/terminal/TerminalService"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
