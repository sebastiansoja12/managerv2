<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-21-delivery-replaced-by" author="s-soja">
        <addColumn tableName="delivery">
            <column name="replaced_by_delivery_id" type="VARCHAR(255)"/>
        </addColumn>
        <sql>
            UPDATE delivery d
            SET replaced_by_delivery_id = substring(ds.comment FROM 'Replaced by pallet delivery (.*)$')
            FROM delivery_step ds
            WHERE ds.delivery_id = d.id
              AND ds.comment LIKE 'Replaced by pallet delivery %'
        </sql>
        <createIndex tableName="delivery" indexName="idx_delivery_replaced_by">
            <column name="replaced_by_delivery_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="2026-10-21-delivery-history" author="s-soja">
        <createTable tableName="delivery_history">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_delivery_history"/>
            </column>
            <column name="delivery_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="delivery_status" type="VARCHAR(32)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_department_id" type="BIGINT"/>
            <column name="destination_department_id" type="BIGINT"/>
            <column name="pickup_method" type="VARCHAR(32)"/>
            <column name="delivery_method" type="VARCHAR(32)"/>
            <column name="pickup_point_id" type="UUID"/>
            <column name="delivery_pickup_point_id" type="UUID"/>
            <column name="supplier_id" type="BIGINT"/>
            <column name="vehicle_id" type="BIGINT"/>
            <column name="signature_required" type="BOOLEAN"/>
            <column name="instructions" type="TEXT"/>
            <column name="planned_at" type="TIMESTAMP"/>
            <column name="step_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="operator_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="delivery_history" indexName="idx_delivery_history_delivery_occurred">
            <column name="delivery_id"/>
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
