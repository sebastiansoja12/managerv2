<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-17-postgresql-table-impersonation-consents" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="impersonation_consents"/>
            </not>
        </preConditions>
        <createTable tableName="impersonation_consents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_impersonation_consents"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="platform_owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="platform_owner_username" type="VARCHAR(255)"/>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="request_expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="decided_by" type="BIGINT"/>
            <column name="decided_by_username" type="VARCHAR(255)"/>
            <column name="decided_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="access_expires_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="impersonation_consents" indexName="idx_impersonation_consents_owner_operator">
            <column name="platform_owner_id"/>
            <column name="operator_id"/>
            <column name="requested_at"/>
        </createIndex>
        <createIndex tableName="impersonation_consents" indexName="idx_impersonation_consents_operator">
            <column name="operator_id"/>
            <column name="requested_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
