<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-postgresql-table-billing-customers" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="billing_customers"/>
            </not>
        </preConditions>
        <createTable tableName="billing_customers">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="company_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_id" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="street" type="VARCHAR(255)"/>
            <column name="postal_code" type="VARCHAR(20)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="country_code" type="VARCHAR(2)"/>
            <column name="invoice_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_billing_customers_user"
                             references="users(user_id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="billing_customers" columnNames="operator_id, tax_id"
                             constraintName="uq_billing_customers_operator_tax_id"/>
        <addUniqueConstraint tableName="billing_customers" columnNames="user_id"
                             constraintName="uq_billing_customers_user_id"/>
    </changeSet>
</databaseChangeLog>
