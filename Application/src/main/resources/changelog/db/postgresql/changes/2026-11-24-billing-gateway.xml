<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-postgresql-payment-gateway-sessions" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="payments"/>
                <not>
                    <columnExists tableName="payments" columnName="checkout_url"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="payments">
            <column name="checkout_url" type="VARCHAR(2048)"/>
            <column name="checkout_expires_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="checkout_attempt" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="payments" indexName="uq_payments_gateway_reference" unique="true">
            <column name="gateway_reference"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-table-processed-webhook-events" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="processed_webhook_events"/>
            </not>
        </preConditions>
        <createTable tableName="processed_webhook_events">
            <column name="event_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
