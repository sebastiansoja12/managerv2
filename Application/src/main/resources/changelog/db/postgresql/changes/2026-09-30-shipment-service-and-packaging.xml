<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-30-shipment-service-and-packaging" author="s-soja">
        <addColumn tableName="shipment">
            <column name="service_level" type="VARCHAR(32)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
            <column name="packaging_type" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="shipment_rd">
            <column name="service_level" type="VARCHAR(32)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
            <column name="packaging_type" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="shipment_aud">
            <column name="service_level" type="VARCHAR(32)"/>
            <column name="packaging_type" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
