<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-05-user-onboarding" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_onboarding"/>
            </not>
        </preConditions>
        <createTable tableName="user_onboarding">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_onboarding"/>
            </column>
            <column name="tutorial_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="tutorial_finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="operator_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="user_onboarding" indexName="idx_user_onboarding_operator">
            <column name="operator_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="2026-11-05-user-onboarding-consents" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_onboarding_consents"/>
            </not>
        </preConditions>
        <createTable tableName="user_onboarding_consents">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_onboarding_consents_onboarding"
                             references="user_onboarding(user_id)"
                             deleteCascade="true"/>
            </column>
            <column name="consent_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="consent_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="user_onboarding_consents" indexName="idx_user_onboarding_consents_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="2026-11-05-mail-templates-user-invitation-generic" author="s-soja">
        <update tableName="mail_templates">
            <column name="subject" value="Zaproszenie do systemu Manager"/>
            <column name="body"><![CDATA[Dzień dobry{{#firstName}} {{firstName}}{{/firstName}},

utworzyliśmy dla Ciebie konto w systemie Manager.

Login: {{username}}

Aby ustawić hasło i aktywować konto, otwórz link:
{{invitationUrl}}

Link jest ważny do {{expiresAt}}.

Pozdrawiamy,
{{fromName}}]]></column>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>template_key = 'user.invitation' AND locale = 'pl'</where>
        </update>
        <update tableName="mail_templates">
            <column name="subject" value="Invitation to Manager"/>
            <column name="body"><![CDATA[Hello{{#firstName}} {{firstName}}{{/firstName}},

an account has been created for you in Manager.

Username: {{username}}

To set your password and activate the account, open the link:
{{invitationUrl}}

The link is valid until {{expiresAt}}.

Best regards,
{{fromName}}]]></column>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>template_key = 'user.invitation' AND locale = 'en'</where>
        </update>
        <update tableName="mail_templates">
            <column name="subject" value="Einladung zu Manager"/>
            <column name="body"><![CDATA[Guten Tag{{#firstName}} {{firstName}}{{/firstName}},

für Sie wurde ein Konto in Manager angelegt.

Benutzername: {{username}}

Um Ihr Passwort festzulegen und das Konto zu aktivieren, öffnen Sie den Link:
{{invitationUrl}}

Der Link ist gültig bis {{expiresAt}}.

Mit freundlichen Grüßen
{{fromName}}]]></column>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>template_key = 'user.invitation' AND locale = 'de'</where>
        </update>
    </changeSet>
</databaseChangeLog>
