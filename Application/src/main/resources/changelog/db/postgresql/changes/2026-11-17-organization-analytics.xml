<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-17-postgresql-table-department-cost" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="department_cost"/>
            </not>
        </preConditions>
        <createTable tableName="department_cost">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="department_code" type="VARCHAR(40)">
                <constraints nullable="false" />
            </column>
            <column name="category" type="VARCHAR(30)">
                <constraints nullable="false" />
            </column>
            <column name="amount" type="NUMERIC(19, 2)">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="incurred_on" type="DATE">
                <constraints nullable="false" />
            </column>
            <column name="description" type="VARCHAR(500)" />
            <column name="recorded_by_user_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="recorded_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
        </createTable>
        <createIndex tableName="department_cost" indexName="idx_department_cost_operator_incurred_on">
            <column name="operator_id"/>
            <column name="incurred_on"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-17-postgresql-shipment-rd-analytics-indexes" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="shipment_rd" indexName="idx_shipment_rd_operator_created_at"/>
            </not>
        </preConditions>
        <createIndex tableName="shipment_rd" indexName="idx_shipment_rd_operator_created_at">
            <column name="operator_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="shipment_rd" indexName="idx_shipment_rd_operator_delivered_at">
            <column name="operator_id"/>
            <column name="delivered_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
