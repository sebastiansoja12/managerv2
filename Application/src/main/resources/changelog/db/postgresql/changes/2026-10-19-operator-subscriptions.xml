<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-19-postgresql-table-operator-subscriptions" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="operator_subscriptions"/>
            </not>
        </preConditions>
        <createTable tableName="operator_subscriptions">
            <column name="subscription_id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_operator_subscriptions"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_operator_subscriptions_operator"/>
            </column>
            <column name="plan" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="operator_subscriptions" baseColumnNames="operator_id"
                                 constraintName="fk_operator_subscriptions_operator"
                                 referencedTableName="operators" referencedColumnNames="operator_id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
        <sql>
            ALTER TABLE operator_subscriptions
                ADD CONSTRAINT ck_operator_subscriptions_plan CHECK (plan IN ('MINI', 'BASIC', 'ENTERPRISE'));
            ALTER TABLE operator_subscriptions
                ADD CONSTRAINT ck_operator_subscriptions_period CHECK (end_date &gt;= start_date);
        </sql>
    </changeSet>
</databaseChangeLog>
