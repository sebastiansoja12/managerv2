<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-20-delivery-read-model" author="s-soja">
        <createTable tableName="delivery_rd">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_delivery_rd"/>
            </column>
            <column name="shipment_id" type="BIGINT"/>
            <column name="target_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_status" type="VARCHAR(32)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_department_id" type="BIGINT"/>
            <column name="destination_department_id" type="BIGINT"/>
            <column name="delivery_method" type="VARCHAR(32)"/>
            <column name="step_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="delivered_at" type="TIMESTAMP"/>
            <column name="operator_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="delivery_rd" indexName="idx_delivery_rd_operator_created">
            <column name="operator_id"/>
            <column name="created"/>
        </createIndex>
        <sql>
            INSERT INTO delivery_rd (
                id, shipment_id, target_type, target_id, delivery_type, delivery_status, status,
                origin_department_id, destination_department_id, delivery_method, step_count, created,
                delivered_at, operator_id
            )
            SELECT d.id, d.shipment_id, d.target_type, d.target_id, d.delivery_type,
                   CASE d.delivery_status
                       WHEN 0 THEN 'DEPOT' WHEN 1 THEN 'CLIENT' WHEN 2 THEN 'DELIVERY' WHEN 3 THEN 'SENDER'
                       WHEN 4 THEN 'LOST' WHEN 5 THEN 'UNKNOWN' WHEN 6 THEN 'DELIVERED' WHEN 7 THEN 'REJECTED'
                       WHEN 8 THEN 'RETURN' WHEN 9 THEN 'UNAVAILABLE' END,
                   d.status, d.origin_department_id, d.destination_department_id, d.delivery_method,
                   (SELECT COUNT(*) FROM delivery_step ds WHERE ds.delivery_id = d.id),
                   d.created, d.delivered_at, d.operator_id
            FROM delivery d
        </sql>
    </changeSet>
</databaseChangeLog>
