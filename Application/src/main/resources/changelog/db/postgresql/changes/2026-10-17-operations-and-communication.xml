<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-17-postgresql-announcements-targeting" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="announcements" columnName="severity"/>
            </not>
        </preConditions>
        <addColumn tableName="announcements">
            <column name="title" type="VARCHAR(200)"/>
            <column name="severity" type="VARCHAR(20)" defaultValue="INFO">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="valid_to" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-10-17-postgresql-table-announcement-target-operators" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="announcement_target_operators"/>
            </not>
        </preConditions>
        <createTable tableName="announcement_target_operators">
            <column name="announcement_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_announcement_target_operators_announcement"
                             references="announcements(id)" deleteCascade="true"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="announcement_target_operators" columnNames="announcement_id, operator_id"
                       constraintName="pk_announcement_target_operators"/>
    </changeSet>

    <changeSet id="2026-10-17-postgresql-table-announcement-target-roles" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="announcement_target_roles"/>
            </not>
        </preConditions>
        <createTable tableName="announcement_target_roles">
            <column name="announcement_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_announcement_target_roles_announcement"
                             references="announcements(id)" deleteCascade="true"/>
            </column>
            <column name="role" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="announcement_target_roles" columnNames="announcement_id, role"
                       constraintName="pk_announcement_target_roles"/>
    </changeSet>

    <changeSet id="2026-10-17-postgresql-table-operator-data-erasures" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="operator_data_erasures"/>
            </not>
        </preConditions>
        <createTable tableName="operator_data_erasures">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="executed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="users_anonymized" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="couriers_anonymized" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="devices_retired" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="operator_data_erasures" indexName="idx_operator_data_erasures_operator">
            <column name="operator_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
