<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-postgresql-payment-refunds" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="payments"/>
                <not>
                    <columnExists tableName="payments" columnName="gateway_payment_intent"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="payments">
            <column name="gateway_payment_intent" type="VARCHAR(255)"/>
            <column name="refund_requested_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="refunded_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="refunded_by" type="BIGINT"/>
        </addColumn>
        <createIndex tableName="payments" indexName="uq_payments_gateway_payment_intent" unique="true">
            <column name="gateway_payment_intent"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-table-payment-late-refunds" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payment_late_refunds"/>
            </not>
        </preConditions>
        <createTable tableName="payment_late_refunds">
            <column name="session_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="gateway_payment_intent" type="VARCHAR(255)"/>
            <column name="payment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="refunded_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="payment_late_refunds" indexName="uq_payment_late_refunds_payment_intent"
                     unique="true">
            <column name="gateway_payment_intent"/>
        </createIndex>
        <createIndex tableName="payment_late_refunds" indexName="idx_payment_late_refunds_payment_id">
            <column name="payment_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
