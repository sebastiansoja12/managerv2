    <changeSet id="2026-11-24-postgresql-table-price-quotes" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="price_quotes"/>
            </not>
        </preConditions>
        <createTable tableName="price_quotes">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="price_list_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
