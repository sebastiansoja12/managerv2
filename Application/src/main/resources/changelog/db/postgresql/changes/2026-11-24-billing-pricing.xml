<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-postgresql-table-price-lists" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="price_lists"/>
            </not>
        </preConditions>
        <createTable tableName="price_lists">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="operator_id" type="BIGINT" />
            <column name="template" type="BOOLEAN">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="insurance_percent" type="DECIMAL(7,3)">
                <constraints nullable="false" />
            </column>
            <column name="vat_percent" type="DECIMAL(7,3)">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
        </createTable>
        <sql>
            ALTER TABLE price_lists ADD CONSTRAINT ck_price_lists_template CHECK (template = (operator_id IS NULL));
            CREATE UNIQUE INDEX uq_price_lists_template ON price_lists (template) WHERE template = true AND operator_id IS NULL;
            CREATE UNIQUE INDEX uq_price_lists_operator ON price_lists (operator_id) WHERE operator_id IS NOT NULL;
        </sql>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-table-price-list-size-classes" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="price_list_size_classes"/>
            </not>
        </preConditions>
        <createTable tableName="price_list_size_classes">
            <column name="price_list_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_price_list_size_classes" references="price_lists(id)" deleteCascade="true" />
            </column>
            <column name="position" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="max_length_cm" type="DECIMAL(10,2)">
                <constraints nullable="false" />
            </column>
            <column name="max_width_cm" type="DECIMAL(10,2)">
                <constraints nullable="false" />
            </column>
            <column name="max_height_cm" type="DECIMAL(10,2)">
                <constraints nullable="false" />
            </column>
            <column name="net_price" type="DECIMAL(19,2)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addPrimaryKey tableName="price_list_size_classes" columnNames="price_list_id, position"
                       constraintName="pk_price_list_size_classes" />
    </changeSet>

