<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-29-delivery-current-target-unique" author="s-soja">
        <sql>CREATE UNIQUE INDEX IF NOT EXISTS uk_delivery_current_target
             ON delivery (target_type, target_id, delivery_type)
             WHERE status &lt;&gt; 'CANCELED'</sql>
    </changeSet>
</databaseChangeLog>
