<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-postgresql-table-payments" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payments"/>
            </not>
        </preConditions>
        <createTable tableName="payments">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="price_quote_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_payments_price_quote_id" />
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="channel" type="VARCHAR(20)" />
            <column name="method" type="VARCHAR(20)" />
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="gateway_reference" type="VARCHAR(255)" />
            <column name="deadline" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="paid_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="recorded_by" type="BIGINT" />
            <column name="department_id" type="BIGINT" />
            <column name="buyer_tax_id" type="VARCHAR(32)" />
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
        </createTable>
        <createIndex tableName="payments" indexName="ix_payments_operator_status_deadline">
            <column name="operator_id" />
            <column name="status" />
            <column name="deadline" />
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-operator-payment-deadline-hours" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="operator_configurations"/>
                <not>
                    <columnExists tableName="operator_configurations" columnName="shipment_payment_deadline_hours"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="operator_configurations">
            <column name="shipment_payment_deadline_hours" type="INT" defaultValueNumeric="72">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-operator-payment-deadline-hours-aud" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="operator_configurations_aud"/>
                <not>
                    <columnExists tableName="operator_configurations_aud" columnName="shipment_payment_deadline_hours"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="operator_configurations_aud">
            <column name="shipment_payment_deadline_hours" type="INT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-11-24-postgresql-shipment-price-quote-id-unique" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="shipment"/>
                <columnExists tableName="shipment" columnName="price_quote_id"/>
                <not>
                    <indexExists tableName="shipment" indexName="uq_shipment_price_quote_id"/>
                </not>
            </and>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_shipment_price_quote_id ON shipment (price_quote_id) WHERE price_quote_id IS NOT NULL;
        </sql>
    </changeSet>
</databaseChangeLog>
