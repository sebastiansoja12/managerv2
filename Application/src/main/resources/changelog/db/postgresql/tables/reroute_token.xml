<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-reroute-token" author="s-soja">
        <createTable tableName="reroute_token">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="token" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="created" type="TIMESTAMP WITH TIME ZONE" />
            <column name="timeout" type="TIMESTAMP WITH TIME ZONE" />
            <column name="parcel_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
