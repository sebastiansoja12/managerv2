<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-process-logs" author="s-soja">
        <createTable tableName="process_logs">
            <column name="process_id" type="UUID">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="request" type="TEXT" />
            <column name="response" type="TEXT" />
            <column name="status" type="VARCHAR(64)" />
            <column name="fault_description" type="VARCHAR(2000)" />
            <column name="device_id" type="VARCHAR(64)" />
            <column name="department_code" type="VARCHAR(255)" />
            <column name="user_id" type="BIGINT" />
            <column name="device_type" type="VARCHAR(64)" />
            <column name="device_user_type" type="VARCHAR(64)" />
            <column name="device_version" type="VARCHAR(255)" />
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="operator_id" type="BIGINT" />
        </createTable>
    </changeSet>
</databaseChangeLog>
