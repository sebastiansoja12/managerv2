<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-reject-reason" author="s-soja">
        <createTable tableName="reject_reason">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="reason" type="VARCHAR(2000)" />
            <column name="shipment_id" type="BIGINT" />
            <column name="recipient" type="VARCHAR(255)" />
            <column name="reject_department_code" type="VARCHAR(255)" />
            <column name="supplier_code" type="VARCHAR(255)" />
            <column name="delivery_status" type="VARCHAR(255)" />
        </createTable>
    </changeSet>
</databaseChangeLog>
