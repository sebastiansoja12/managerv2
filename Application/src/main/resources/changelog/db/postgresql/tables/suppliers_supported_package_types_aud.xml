<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-suppliers-supported-package-types-aud" author="s-soja">
        <createTable tableName="suppliers_supported_package_types_aud">
            <column name="rev" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_suppliers_supported_package_types_aud" />
            </column>
            <column name="revtype" type="SMALLINT" />
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_suppliers_supported_package_types_aud" />
            </column>
            <column name="package_type" type="VARCHAR(50)" />
        </createTable>
    </changeSet>
</databaseChangeLog>
