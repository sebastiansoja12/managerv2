<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-operator-configurations" author="s-soja">
        <createTable tableName="operator_configurations">
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="supports_domestic_shipping" type="BOOLEAN" />
            <column name="supports_international_shipping" type="BOOLEAN" />
            <column name="supports_express_shipping" type="BOOLEAN" />
            <column name="supports_same_day_delivery" type="BOOLEAN" />
            <column name="supports_cash_on_delivery" type="BOOLEAN" />
            <column name="supports_parcel_lockers" type="BOOLEAN" />
            <column name="supports_pickup_points" type="BOOLEAN" />
            <column name="supports_home_delivery" type="BOOLEAN" />
            <column name="supports_saturday_delivery" type="BOOLEAN" />
            <column name="supports_sunday_delivery" type="BOOLEAN" />
            <column name="supports_return_shipments" type="BOOLEAN" />
            <column name="provides_tracking" type="BOOLEAN" />
            <column name="provides_insurance" type="BOOLEAN" />
            <column name="max_weight" type="DOUBLE PRECISION" />
            <column name="min_weight" type="DOUBLE PRECISION" />
            <column name="max_length" type="DOUBLE PRECISION" />
            <column name="max_width" type="DOUBLE PRECISION" />
            <column name="max_height" type="DOUBLE PRECISION" />
            <column name="max_shipment_value" type="DOUBLE PRECISION" />
            <column name="min_delivery_days" type="INT" />
            <column name="max_delivery_days" type="INT" />
            <column name="express_delivery_days" type="INT" />
            <column name="same_day_delivery_hours" type="INT" />
            <column name="international_delivery_days" type="INT" />
            <column name="shipment_validate_address_data" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_require_recipient_phone" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_require_recipient_email" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_prevent_duplicate_tracking" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_require_sender_reference" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_validate_postal_code" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_auto_generate_labels" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_include_return_label" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_attach_packing_slip" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_label_format" type="VARCHAR(32)" defaultValue="PDF_A6" />
            <column name="shipment_allow_oversized" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_default_status" type="VARCHAR(32)" defaultValue="CREATED" />
            <column name="shipment_default_service_level" type="VARCHAR(32)" defaultValue="STANDARD" />
            <column name="shipment_auto_assign_courier" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_auto_close_delivered" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_generate_tracking_number" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="shipment_cancellation_window_minutes" type="INT" defaultValueNumeric="30" />
            <column name="shipment_pickup_cutoff_time" type="VARCHAR(16)" defaultValue="16:00" />
            <column name="shipment_tracking_number_key" type="VARCHAR(20)" defaultValue="MGR" />
            <column name="shipment_tracking_number_separator" type="VARCHAR(3)" defaultValue="-" />
            <column name="shipment_tracking_number_source" type="VARCHAR(32)" defaultValue="SEQUENCE" />
            <column name="shipment_tracking_number_random_length" type="INT" defaultValueNumeric="8" />
            <column name="shipment_tracking_number_include_date" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_tracking_number_date_format" type="VARCHAR(32)" defaultValue="YYYYMMDD" />
            <column name="shipment_tracking_number_uppercase" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_notify_recipient_on_created" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_notify_recipient_on_dispatched" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_notify_recipient_on_delivered" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_notify_sender_on_exception" type="BOOLEAN" defaultValueBoolean="true" />
            <column name="shipment_notification_channel" type="VARCHAR(32)" defaultValue="SMS" />
        </createTable>
    </changeSet>
</databaseChangeLog>
