<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-scanners" author="s-soja">
        <createTable tableName="scanners">
            <column name="device_id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="external_device_id" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="device_type" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="BIGINT" />
            <column name="department_code" type="VARCHAR(255)" />
            <column name="hardware_uuid" type="UUID" />
            <column name="serial_number" type="VARCHAR(255)" />
            <column name="imei" type="VARCHAR(255)" />
            <column name="mac_address" type="VARCHAR(255)" />
            <column name="asset_tag" type="VARCHAR(255)" />
            <column name="barcode" type="VARCHAR(255)" />
            <column name="external_system_id" type="VARCHAR(255)" />
            <column name="mdm_device_id" type="VARCHAR(255)" />
            <column name="manufacturer" type="VARCHAR(255)" />
            <column name="model" type="VARCHAR(255)" />
            <column name="product_name" type="VARCHAR(255)" />
            <column name="cpu" type="VARCHAR(255)" />
            <column name="ram_mb" type="INT" />
            <column name="storage_mb" type="INT" />
            <column name="screen_resolution" type="VARCHAR(255)" />
            <column name="has_scanner" type="BOOLEAN" />
            <column name="has_camera" type="BOOLEAN" />
            <column name="has_nfc" type="BOOLEAN" />
            <column name="has_gps" type="BOOLEAN" />
            <column name="ruggedized" type="BOOLEAN" />
            <column name="ip_address" type="VARCHAR(255)" />
            <column name="public_ip_address" type="VARCHAR(255)" />
            <column name="network_type" type="VARCHAR(50)" />
            <column name="carrier" type="VARCHAR(255)" />
            <column name="sim_serial" type="VARCHAR(255)" />
            <column name="roaming" type="BOOLEAN" />
            <column name="vpn_connected" type="BOOLEAN" />
            <column name="wifi_ssid" type="VARCHAR(255)" />
            <column name="bluetooth_mac" type="VARCHAR(255)" />
            <column name="previous_user_id" type="BIGINT" />
            <column name="team_id" type="BIGINT" />
            <column name="vehicle_id" type="BIGINT" />
            <column name="assigned_role" type="VARCHAR(255)" />
            <column name="assigned_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="unassigned_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="scan_type" type="VARCHAR(50)" />
            <column name="scanner_type" type="VARCHAR(50)" />
            <column name="operator_id" type="BIGINT" />
        </createTable>
    </changeSet>
</databaseChangeLog>
