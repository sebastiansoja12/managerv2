<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-communication-log-details" author="s-soja">
        <createTable tableName="communication_log_details">
            <column autoIncrement="true" name="communication_log_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="process_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="device_id" type="VARCHAR(64)" />
            <column name="process_type" type="VARCHAR(64)" />
            <column name="service_type" type="VARCHAR(64)" />
            <column name="created_by" type="BIGINT" />
            <column name="updated_by" type="BIGINT" />
            <column name="department_code" type="VARCHAR(255)" />
            <column name="source_service" type="VARCHAR(255)" />
            <column name="target_service" type="VARCHAR(255)" />
            <column name="request" type="TEXT" />
            <column name="response" type="TEXT" />
            <column name="fault_description" type="VARCHAR(2000)" />
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="operator_id" type="BIGINT" />
        </createTable>
    </changeSet>
</databaseChangeLog>
