<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-device-pair" author="s-soja">
        <createTable tableName="device_pair">
            <column name="device_pair_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="device_id" type="VARCHAR(64)" />
            <column name="paired" type="BOOLEAN">
                <constraints nullable="false" />
            </column>
            <column name="pair_time" type="TIMESTAMP WITH TIME ZONE" />
            <column name="error_description" type="VARCHAR(255)" />
            <column name="pair_key" type="VARCHAR(255)" />
            <column name="pair_key_expires_at" type="TIMESTAMP WITH TIME ZONE" />
        </createTable>
    </changeSet>
</databaseChangeLog>
