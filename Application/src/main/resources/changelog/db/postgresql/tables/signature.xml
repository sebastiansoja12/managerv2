<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-signature" author="s-soja">
        <createTable tableName="signature">
            <column name="shipment_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="signer_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="signed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="signature_method" type="VARCHAR(64)">
                <constraints nullable="false" />
            </column>
            <column name="document_reference" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="signature" type="BYTEA">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
