<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-delivery" author="s-soja">
        <createTable tableName="delivery">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="shipment_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="created" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="department_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="supplier_code" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="delivery_status" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="token" type="VARCHAR(255)" />
            <column name="operator_id" type="BIGINT" />
        </createTable>
    </changeSet>
</databaseChangeLog>
