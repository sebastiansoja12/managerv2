<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-delivery-network" author="s-soja">
        <createTable tableName="delivery_network">
            <column name="delivery_network_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_delivery_network" />
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column defaultValueNumeric="0" name="version" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
