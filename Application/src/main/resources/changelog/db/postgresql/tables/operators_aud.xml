<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-04-postgresql-table-operators-aud" author="s-soja">
        <createTable tableName="operators_aud">
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="rev" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="revtype" type="SMALLINT" />
            <column name="registering_user_id" type="BIGINT" />
            <column name="tax_id" type="VARCHAR(64)" />
            <column name="supports_lockers" type="BOOLEAN" />
            <column name="supports_international_shipping" type="BOOLEAN" />
            <column name="supports_cash_on_delivery" type="BOOLEAN" />
            <column name="contact_phone" type="VARCHAR(64)" />
            <column name="contact_email" type="VARCHAR(255)" />
            <column name="name" type="VARCHAR(255)" />
            <column name="status" type="VARCHAR(32)" />
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="contract_start_date" type="DATE" />
            <column name="contract_end_date" type="DATE" />
            <column name="founded_date" type="DATE" />
        </createTable>
    </changeSet>
</databaseChangeLog>
