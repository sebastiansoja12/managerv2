<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="s-soja" id="extend-geocoding-credentials-for-encryption-2026-08-13">
        <modifyDataType tableName="geocoding_configurations" columnName="api_password" newDataType="TEXT"/>
        <modifyDataType tableName="geocoding_configurations" columnName="api_key" newDataType="TEXT"/>
