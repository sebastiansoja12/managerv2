<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-04-route-tracker-postgresql-table-route-log" author="s-soja">
        <createTable tableName="route_log">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_route_log"/>
            </column>
            <column name="shipment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="return_code" type="VARCHAR(255)"/>
            <column name="fault_description" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
