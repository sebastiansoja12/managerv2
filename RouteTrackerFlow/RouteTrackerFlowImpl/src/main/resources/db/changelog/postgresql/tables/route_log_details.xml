<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-04-route-tracker-postgresql-table-route-log-details" author="s-soja">
        <createTable tableName="route_log_details">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_route_log_details"/>
            </column>
            <column name="route_log_record_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="event_id" type="VARCHAR(36)"/>
            <column name="device_id" type="VARCHAR(255)"/>
            <column name="version" type="VARCHAR(255)"/>
            <column name="created" type="TIMESTAMP"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="process_type" type="INTEGER"/>
            <column name="request" type="TEXT"/>
            <column name="shipment_status" type="INTEGER"/>
            <column name="operator_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
            <column name="department_id" type="BIGINT"/>
            <column name="supplier_id" type="BIGINT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
