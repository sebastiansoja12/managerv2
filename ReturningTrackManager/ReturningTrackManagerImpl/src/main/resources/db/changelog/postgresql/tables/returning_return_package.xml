<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-04-returning-postgresql-table-returning-return-package" author="s-soja">
        <createTable tableName="returning_return_package">
            <column name="return_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_returning_return_package"/>
            </column>
            <column name="shipment_id" type="BIGINT"/>
            <column name="reason" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="return_status" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="return_token" type="VARCHAR(255)"/>
            <column name="assigned_department" type="VARCHAR(255)"/>
            <column name="returned_department" type="VARCHAR(255)"/>
            <column name="assigned_to" type="BIGINT"/>
            <column name="processed_by" type="BIGINT"/>
            <column name="reason_code" type="VARCHAR(64)"/>
            <column name="operator_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
