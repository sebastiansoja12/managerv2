<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="rtm-001-create-return-package" author="s-soja">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="returning_return_package"/>
            </not>
        </preConditions>
        <createTable tableName="returning_return_package">
            <column name="return_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="shipment_id" type="BIGINT"/>
            <column name="reason" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="return_status" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="return_token" type="VARCHAR(255)"/>
            <column name="assigned_department" type="VARCHAR(255)"/>
            <column name="returned_department" type="VARCHAR(255)"/>
            <column name="assigned_to" type="BIGINT"/>
            <column name="processed_by" type="BIGINT"/>
            <column name="reason_code" type="VARCHAR(64)"/>
            <column name="operator_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="rtm-002-add-operator-id" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="returning_return_package"/>
            <not>
                <columnExists tableName="returning_return_package" columnName="operator_id"/>
            </not>
        </preConditions>
        <addColumn tableName="returning_return_package">
            <column name="operator_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="rtm-003-index-return-operator-department" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="returning_return_package"/>
            <not>
                <indexExists tableName="returning_return_package"
                             indexName="idx_return_operator_department_updated"/>
            </not>
        </preConditions>
        <createIndex tableName="returning_return_package" indexName="idx_return_operator_department_updated">
            <column name="operator_id"/>
            <column name="assigned_department"/>
            <column name="updated_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
